menuconfig WIFI_GS1500M_AT
	bool "GainSpan GS1500M AT WiFi offload"
	default y
	depends on DT_HAS_GAINSPAN_GS1500M_AT_ENABLED
	select WIFI
	select WIFI_OFFLOAD
	select NET_L2_WIFI_MGMT
	select NET_OFFLOAD
	help
	  UART AT offload driver for the GainSpan GS1500M Serial2WiFi module.
	  Reuses the portable lib/wifi/gs1500m AT library. Exposes Zephyr
	  wifi_mgmt plus IPv4 TCP/UDP net_offload (client). Module DNSLOOKUP
	  is available via gs1500m_dns_lookup(); listen/accept and TLS socket
	  offload are not implemented yet.
	  Enable the gs1500m DT node (status okay) from the application overlay.

if WIFI_GS1500M_AT

config WIFI_GS1500M_AT_WORKQ_STACK_SIZE
	int "GS1500M WiFi workqueue stack size"
	default 8192

config WIFI_GS1500M_AT_WORKQ_PRIORITY
	int "GS1500M WiFi workqueue priority"
	default 7

config WIFI_GS1500M_AT_RX_STACK_SIZE
	int "GS1500M AT RX poll thread stack size"
	default 1024

config WIFI_GS1500M_AT_RX_PRIORITY
	int "GS1500M AT RX poll thread priority"
	default 8

config WIFI_GS1500M_AT_INIT_TIMEOUT_MS
	int "Module AT bring-up timeout (ms)"
	default 8000

config WIFI_GS1500M_AT_MAX_SOCKETS
	int "Max concurrent offload sockets"
	default 4
	range 1 16

config WIFI_GS1500M_AT_TX_BUF_SIZE
	int "TX linearization buffer for net_offload send"
	default 1500
	range 64 9999

endif # WIFI_GS1500M_AT
