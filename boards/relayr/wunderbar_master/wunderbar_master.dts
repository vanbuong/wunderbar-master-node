 * SPDX-License-Identifier: Apache-2.0
 *
 * Relayr WunderBar master module — MK24FN1M0VDC12.
 *
 * Clock sources (from schematic):
 *   - Y1  12 MHz on EXTAL0/XTAL0 with C17/C18 = 12 pF
 *   - X8  32.768 kHz on EXTAL32/XTAL32 with C104/C105 = 12 pF
 *
 * Zephyr SoC support uses the MK64F12 tree (superset / shared Kinetis K
 * enablement). Target core clock is 120 MHz via MCG PEE.
 */

/dts-v1/;

#include <nxp/kinetis/nxp_k6x.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <freq.h>

/ {
	model = "Relayr WunderBar Master Module";
	compatible = "relayr,wunderbar-master", "nxp,mk24f12", "nxp,k6x";

	aliases {
		led0 = &led_pta29;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	leds {
		compatible = "gpio-leds";

		/* User LED on PTA29 (GPIOA pin 29). Active-high assumed;
		 * change to GPIO_ACTIVE_LOW if the LED sinks to ground through
		 * an active-low buffer on your PCB revision.
		 */
		led_pta29: led_0 {
			gpios = <&gpioa 29 GPIO_ACTIVE_HIGH>;
			label = "PTA29 LED";
		};
	};
};

&sim {
	pllfll-select = <KINETIS_SIM_PLLFLLSEL_MCGPLLCLK>;
	er32k-select = <KINETIS_SIM_ER32KSEL_RTC>;
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(120)>;
};

&rtc {
	status = "okay";
	clock-frequency = <32768>;
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpiod {
	status = "okay";
};

&gpioe {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
			read-only;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(472)>;
		};

		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 DT_SIZE_K(472)>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 DT_SIZE_K(32)>;
		};
	};
};
